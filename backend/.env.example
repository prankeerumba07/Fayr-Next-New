# Copy to .env for local development:  cp .env.example .env
# Never commit a real .env — it is gitignored.

# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL (used from step 0.2 onward — matches docker-compose.yml).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://fayr:fayr@localhost:5432/fayr_dev?schema=public

# Authentication (step 0.3 onward).
# JWT_ACCESS_SECRET signs access tokens — REQUIRED, no default, min 32 chars.
# Generate a strong one:  openssl rand -base64 48
# Use a DIFFERENT secret per environment; never reuse the dev value in prod.
JWT_ACCESS_SECRET=replace-with-`openssl rand -base64 48`-min-32-chars
# Access-token lifetime (ms-style string). Short by design; refresh rotates.
JWT_ACCESS_TTL=15m
# Refresh-token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30

# CORS allowlist (comma-separated browser origins). Empty in dev reflects the
# request origin; in production set it explicitly, e.g.
# CORS_ORIGINS=https://app.fayr.example
CORS_ORIGINS=

# Staff / Admin (step 2.1). The staff panel is a SEPARATE trust domain.
# STAFF_JWT_SECRET signs staff access tokens — REQUIRED, no default, min 32 chars,
# and MUST be different from JWT_ACCESS_SECRET (a user token must never verify as
# a staff token). Generate:  openssl rand -base64 48
STAFF_JWT_SECRET=replace-with-a-DIFFERENT-`openssl rand -base64 48`-min-32-chars
# Staff access-token lifetime (ms-style string). No refresh rotation on the staff
# side — staff re-login when it expires.
STAFF_JWT_TTL=8h
# Optional bootstrap admin: if BOTH are set, an ADMIN staff account is created on
# boot when absent (idempotent). Leave unset to provision staff another way.
# STAFF_BOOTSTRAP_EMAIL=admin@fayr.local
# STAFF_BOOTSTRAP_PASSWORD=change-me-to-a-strong-passphrase

# --- One-time-code delivery (SMS) -----------------------------------------
# Which sender delivers the login code. UNSET or 'dev' logs it to the server
# console and sends nothing — that is the default and it must keep working with
# no credentials present, so a fresh clone can run the whole auth flow offline.
#
# Every value below is FAKE. Put real credentials in .env only (gitignored).
# The security behaviour — per-number cooldown, 5-attempt lock, per-IP throttle —
# lives in AuthService, ABOVE the sender, so changing this line cannot change it.
SMS_PROVIDER=dev

# Message Central (MessageNow — plain SMS, we supply the code and the text).
# Console → Settings/Profile. The password is sent BASE-64 ENCODED, not raw:
#   printf '%s' 'your-console-password' | base64
MESSAGECENTRAL_CUSTOMER_ID=C-0000000000000000
MESSAGECENTRAL_PASSWORD_BASE64=bm90LWEtcmVhbC1wYXNzd29yZA==
MESSAGECENTRAL_EMAIL=you@example.com
# 6 characters. On the free international route this is usually ignored and the
# message arrives from a random numeric sender — see the SMS Retriever note in
# src/auth/sms/README.md.
MESSAGECENTRAL_SENDER_ID=EXAMPL

# 2Factor.in — the Indian route. We pass OUR OWN code, never their AUTOGEN,
# because a provider-generated code would never match the hash we stored.
#
# ⚠️ Their API puts the KEY and the CODE in the URL PATH, not the query string.
# Nothing may log a raw 2Factor URL; scrubUrlForLog handles it.
TWOFACTOR_API_KEY=00000000-0000-0000-0000-000000000000
# Optional. BLANK means "the account's default approved template" — which is a
# real, working setting, not a missing one. A NAMED template must already be
# approved in the 2Factor dashboard or every send returns Status:"Error".
TWOFACTOR_TEMPLATE_NAME=
# Their docs show +91XXXXXXXXXX; some accounts want the plain 10 digits instead.
# Switch here rather than editing code if sends are rejected.
TWOFACTOR_NUMBER_FORMAT=e164

# Twilio and MSG91 are deliberately ABSENT: they are not implemented, and
# SMS_PROVIDER rejects any name this build cannot actually use, so there is no
# half-configured state to fall into.
