// Fayr backend — Prisma schema (PostgreSQL).
//
// Phase 0 defined the AUTH FOUNDATION: users, OTP challenges, refresh tokens.
// Phase 1 (this schema) adds the DOMAIN: campaigns, tasks (the persisted state
// machine), the append-only double-entry wallet ledger, and the ticket ledger —
// added as NEW models + a new migration, never by editing an applied migration.
//
// Conventions:
//   - UUID primary keys (opaque, non-enumerable — safe to expose in URLs/tokens).
//   - snake_case table names via @@map, so the SQL reads naturally.
//   - Secrets (OTP codes, refresh tokens) are stored ONLY as hashes — a DB leak
//     must never reveal a usable credential.
//   - Money is BigInt paise (integer), never a float, never a mutated running
//     balance. A balance is always SUM() over append-only ledger legs.
//   - Ledgers (wallet, tickets) are APPEND-ONLY: a posted row is never updated
//     or deleted (no @updatedAt on those models). Corrections are new entries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A Fayr user. Authentication is mobile-number-only (E.164). Profile and
/// fraud-anchor fields (name, PAN, UPI/bank for dedup) are added in later phases.
model User {
  id          String     @id @default(uuid()) @db.Uuid
  mobile      String     @unique // E.164, e.g. +919876543210
  // Human-friendly public identifier shown in the app (e.g. FAYR-100001). It is
  // DISPLAY-ONLY: the DB fills it from a sequence, and NO endpoint ever accepts
  // it as a lookup input — id (UUID) and mobile stay the only lookup keys. The
  // sequence starts at an offset so the value never reveals signup order/count.
  displayId   String     @unique @default(dbgenerated("('FAYR-'::text || lpad((nextval('user_display_seq'::regclass))::text, 6, '0'::text))"))
  status      UserStatus @default(ACTIVE)
  // PAN anchor (fraud loophole 1): at most one account per PAN. Nullable until the
  // user first cashes out; @unique makes the one-user-per-PAN rule a DB invariant.
  pan         String?    @unique
  // ── Profile, collected by the first-run setup sequence ───────────────────
  // All optional: an account is fully usable before setup runs, and a user who
  // skips or abandons setup must never be locked out of the app. `setupDoneAt`
  // is what the app checks to decide whether to show the sequence again — a
  // non-null name is NOT the same thing, because a user may finish setup while
  // declining to give a name.
  name        String?
  ageBand     String? // one of AGE_BANDS; a band, never a date of birth
  gender      String? // one of GENDERS, includes "Prefer not to say"
  categories  String[]   @default([]) // shopping interests, drives the feed later
  platforms   String[]   @default([]) // marketplaces they already shop on
  setupDoneAt DateTime?

  // CONSENT AS A RECORD, NOT A SCREEN.
  // Under the DPDP Act a claim of consent with no timestamp and no version is
  // worthless: you cannot show WHAT was agreed to or WHEN. Both are written by the
  // SERVER when the user takes the affirmative action in setup — a client-supplied
  // timestamp would prove nothing. Nullable because a user exists before consenting.
  termsVersion    String?
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  otpChallenges      OtpChallenge[]
  refreshTokens      RefreshToken[]
  tasks              Task[]
  ticketEntries      TicketEntry[]
  walletAccounts     WalletAccount[]
  supportQuestions   SupportQuestion[]
  payoutMethods      PayoutMethod[]
  withdrawals        Withdrawal[]
  screenshotUploads  ScreenshotUpload[]
  assistantQuestions AssistantQuestion[]
  chats              Chat[]
  shopSignIns        ShopSignIn[]
  userEvents         UserEvent[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

/// A one-time-password challenge for login/registration.
/// The 6-digit code is NEVER stored in plaintext — only a hash — so a database
/// leak cannot reveal a live code. Rows are short-lived and single-use
/// (consumedAt), with an attempt counter that lets the service throttle brute
/// force and stop reuse.
model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  mobile     String // target number (a User may or may not exist yet)
  codeHash   String // hash of the 6-digit code — never the code itself
  purpose    OtpPurpose @default(LOGIN)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([mobile, createdAt])
  @@map("otp_challenges")
}

enum OtpPurpose {
  LOGIN
}

/// A refresh token in the JWT rotation scheme.
/// Only a HASH of the opaque token is stored, so the database never holds a
/// usable token. Rotation revokes the old row (revokedAt) and issues a new one;
/// revokedAt + expiresAt gate validity. Device metadata supports a future
/// "your active sessions" screen and targeted revocation.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@map("refresh_tokens")
}

// ===========================================================================
// PHASE 1 — DOMAIN
// ===========================================================================

/// A marketplace Fayr operates on. Amazon is the only one used in Phase 1; the
/// rest are modelled now so campaigns/tasks never need an enum-widening
/// migration later. Launch order is Amazon first, Flipkart fast-follow.
enum Platform {
  AMAZON
  FLIPKART
  MEESHO
  MYNTRA
  BLINKIT
  ZEPTO
  INSTAMART
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// The forward money-progression states of a task. REFUNDED is terminal.
/// Expiry/cancellation is modelled ORTHOGONALLY (closedAt/closeReason), so these
/// six remain exactly the proven progression in src/taskflow.js — the ranking
/// logic of the ported transition() must not be disturbed by lifecycle closure.
enum TaskState {
  CLAIMED
  PURCHASED
  DELIVERED
  REVIEWED
  HOLDING
  REFUNDED
}

enum WalletAccountKind {
  USER // one per user — their refundable balance
  HOUSE // system funding account (the other leg of a refund)
  PAYOUT // system clearing account for withdrawals
}

enum LedgerKind {
  REFUND
  WITHDRAWAL
  ADJUSTMENT
}

enum TicketReason {
  SIGNUP_GRANT // +15 on registration
  CLAIM // -5 when a campaign is claimed
  EXPIRY_RETURN // +5 back if the claim expires with no purchase
  COMPLETION_RETURN // +10 after full completion + withdrawal
  ADJUSTMENT // manual correction (append-only, never edits a prior row)
}

enum PayoutMethodType {
  UPI // a UPI VPA, e.g. name@bank
  BANK // an account number + IFSC
}

enum PayoutMethodStatus {
  ACTIVE
  DISABLED // replaced/removed by the user; kept (never deleted) for audit
}

/// Withdrawal lifecycle. Funds are RESERVED at request (debited USER -> PAYOUT),
/// so the available balance can't be double-withdrawn; a REJECTED/FAILED request
/// reverses that leg back to the user. PAID records the external disbursement UTR
/// and triggers the +10 completion grant.
enum WithdrawalStatus {
  REQUESTED // created by the user; funds reserved into the PAYOUT clearing account
  APPROVED // staff approved; awaiting disbursement
  PAID // disbursed externally (UTR recorded); completion tickets granted
  REJECTED // staff rejected; reserved funds reversed to the user
  FAILED // disbursement failed; reserved funds reversed to the user
}

/// A review-and-refund task template an operator publishes. Claiming a campaign
/// spawns a Task. Read-only in Phase 1 (seeded in 1.4); admin CRUD is a later
/// phase. Money fields are integer paise.
model Campaign {
  id       String         @id @default(uuid()) @db.Uuid
  platform Platform       @default(AMAZON)
  status   CampaignStatus @default(ACTIVE)

  title       String
  productName String
  category    String? // drives the return-window policy (see taskflow policy table)
  /// Per-campaign Terms & Conditions shown to the user on the campaign detail
  /// screen before they claim. Free text (one rule per line by convention).
  /// Optional — a campaign with none falls back to the app's default T&C copy.
  terms       String?

  /// Expected product price in integer paise — used ON-DEVICE to match the order
  /// by name + amount (campaigns carry no marketplace product id). Never a float.
  productPricePaise BigInt

  /// Payout policy. The refundable figure is computed at refund time from the
  /// VERIFIED item price; these bound it: min(itemPaise * payoutPercent/100, cap).
  payoutPercent  Int     @default(100)
  payoutCapPaise BigInt?

  ticketCost       Int  @default(5) // tickets consumed to claim
  returnWindowDays Int? // optional per-campaign override of the category policy
  minRating        Int? // minimum star rating the review must carry, if set
  totalSlots       Int? // max total claims; null = unlimited

  asin       String? // Amazon target (optional — matching is name+amount)
  productUrl String?
  imageUrl   String?

  /// THE EXACT PHRASE TO TYPE INTO THE SHOP'S OWN SEARCH BOX, or null.
  ///
  /// Hand-written by ops, and deliberately NOT derivable from `productName`.
  /// The product name is the catalogue's name and is what the refund is matched
  /// against; this is what a real person types to find the thing on that shop.
  /// On the owner's own design the campaign is "Perfora Purple Whitening
  /// Toothpaste, 75ml" and the bar reads "purple corrector toothpaste perfora,
  /// 75 ml".
  ///
  /// NULL IS AN HONEST ANSWER AND THE APP SAYS SO. It never falls back to the
  /// product name: a keyword that finds the wrong product is worse than none,
  /// and a quiet fallback would hide from ops that this needs writing.
  searchKeyword String?

  /// WHAT THE SHOP'S OWN PAGE LOOKED LIKE the last time a person opened it, and
  /// when. One of LIVE_STATES in live-check/live-page.rules.ts.
  ///
  /// A PROJECTION of the most recent live check, never the source of truth — the
  /// runs themselves are in live_page_check_runs. It lives here because the app's
  /// feed reads it on every load and must not join to a history table to draw a
  /// card. Written only by the live check.
  liveState     String?
  liveCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([platform, status])
  @@map("campaigns")
}

/// A user's claim on a campaign — the persisted state-machine instance. The
/// authoritative transition() (ported from src/taskflow.js in 1.5) reads/writes
/// this row. Fields the DB must query or constrain are promoted to columns; the
/// exact nested evidence the pure functions emit lives in `evidence` (JSONB), so
/// transition() can hydrate and run unchanged.
/// SOMEBODY SIGNED IN AT A SHOP, AND WHEN.
///
/// ONE OF THE TWO STEPS IN THE WHOLE JOURNEY THAT NOTHING RECORDED. Before this
/// table, Fayr could not tell somebody who never went to the shop from somebody
/// who went and gave up: both looked identical from our side, because signing in
/// happens on the shop's own page and nothing about it reached us.
///
/// ONE ROW PER PERSON PER SHOP, FOR EVER, and the database enforces it rather
/// than the code hoping. `firstAt` is the FIRST time it happened and is never
/// moved, because the question this table answers is "did they get this far",
/// and a moment that keeps sliding forward cannot answer it.
///
/// WHAT IS DELIBERATELY NOT HERE: no password, no code, no cookie, no token, no
/// account number, and no name. Fayr never sees a single thing somebody types on
/// a shop's page, so there is nothing of that kind to store. This row says one
/// person got signed in at one shop at one moment, and nothing else.
model ShopSignIn {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform

  /// The first time this person was seen signed in at this shop. Never updated.
  firstAt   DateTime @default(now())
  /// How Fayr knew. Words, so a row can be read a year later without the code.
  howWeKnew String

  createdAt DateTime @default(now())

  /// The rule that makes "written down exactly once" a fact and not an intention.
  @@unique([userId, platform])
  @@index([platform])
  @@map("shop_sign_ins")
}

model Task {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String   @db.Uuid
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  platform Platform
  state    TaskState @default(CLAIMED)
  /// Frozen at claim from the campaign, so a later campaign edit can never move a
  /// live task's return window.
  category String?

  // Match target (opaque to the pure machine; discrete here for querying).
  targetAsin     String?
  targetProduct  String?
  targetReviewId String?

  // Promoted, queryable projections of `evidence` (kept in sync on every write):
  /// The marketplace order number. Promoted out of `evidence` so ONE real
  /// purchase cannot be paid out on several campaigns unseen: the refund gate
  /// looks for a sibling task on the same (platform, orderId).
  orderId                  String?
  /// WHICH LINE of that order — the ASIN, Flipkart pid, Meesho sub-order id or
  /// Instamart variant id, whichever the marketplace itself stated. Promoted for
  /// the same reason as orderId: the gate reads an index, not JSONB.
  ///
  /// NULL is meaningful and is NOT "a different line". Two tasks on one order
  /// number may both pay only when BOTH name a line and the lines differ;
  /// anything else goes to a human. Zepto and Blinkit are permanently null here
  /// because their only candidate identifier is a row number.
  itemId                   String?
  /// Staff answer to a held (platform, orderId) collision: this really is a
  /// separate item in one basket, pay it. Set only by a SUPPORT/ADMIN override,
  /// audited, and read only by the refund gate.
  duplicateOrderApproved   Boolean   @default(false)
  returned                 Boolean? // TRI-STATE: null = unknown, which the refund gate treats differently from false
  itemPaise                BigInt? // the VERIFIED refundable item price (never the order total)
  deliveredAt              DateTime?
  /// WHAT THE SHOP ITSELF SAID ITS RETURN WINDOW CLOSES, at the last instant of
  /// that day, or null when its page never said.
  ///
  /// NOT the same column as windowEndsAt below it, and the two must not be
  /// confused. windowEndsAt is the ANSWER — what the hold is actually anchored
  /// to. This is one of the two INPUTS to it: the shop's own statement, read off
  /// the order page in words ("Return window closed on 19 June 2026"). The other
  /// input is the operator's policy table in engine/return-policy.ts, which
  /// still says of itself that no marketplace exposes this date — true for six
  /// of the seven, and not for Amazon.
  ///
  /// windowEnd takes the LATER of the two, so this can only ever lengthen a
  /// hold. Promoted out of the evidence JSONB for the same reason as the columns
  /// around it: so a person asking "why is this one still held" can be answered
  /// from an index rather than by digging.
  statedReturnWindowEndsAt DateTime?
  reviewPublished          Boolean?
  windowEndsAt             DateTime? // delivery + return window; anchors the hold AND the 1.6 scheduler
  claimExpiresAt           DateTime? // deadline to purchase; past it with no purchase -> tickets returned

  /// THEY TAPPED BUY AND WENT TO THE SHOP. The moment our side recorded it.
  ///
  /// This is the step the journey never had. Before it there was no instant to
  /// measure a purchase against except the claim, so an order could only ever be
  /// compared to when somebody said yes to an offer, not to when they actually
  /// went shopping. The shop's own timestamp on the order is now checked against
  /// THIS, in engine/shop-visit.ts.
  ///
  /// It is also the consent. The pop-up in front of them before they leave has one
  /// button, they cannot reach the shop without tapping it, and tapping it is both
  /// the leaving and the agreeing. So there is one row for both and not two.
  ///
  /// WRITE ONCE. A second tap on the same task must not move it, or somebody could
  /// walk their own two hour hold forward for ever by tapping again. The service
  /// refuses the second write and the end to end walk proves it.
  wentToShopAt        DateTime?
  /// The end of the two hour hold that the tap above started. Materialised rather
  /// than worked out on read, for the same reason claimExpiresAt and windowEndsAt
  /// are: the sweep has to be able to query for holds that have ended.
  shopHoldEndsAt      DateTime?
  /// The words they were shown on that pop-up, frozen from the server's own copy.
  ///
  /// The same reasoning as offerTermsText directly above: a record of "they agreed
  /// to whatever the pop-up says now" is not a record. The times inside it were
  /// worked out from this task's own hold, so the sentence they read is the
  /// sentence kept.
  shopVisitNoticeText String?

  /// THEY TAPPED THROUGH TO WRITE THE REVIEW. The moment our side recorded it.
  ///
  /// ── WHY IT IS HERE AND NOT ONLY ON THE PHONE ──────────────────────────────
  ///
  /// REVIEW-FLOW-PROMPT.md, step fourteen, in the owner's own words: "When they
  /// tap through to the review page, the backend must know they left for the
  /// review — the same way the shop visit for buying is recorded. It belongs on
  /// the record, not only on the phone."
  ///
  /// It buys two things a note on a phone cannot. The screen that says "you told
  /// us you posted it two hours ago" needs an instant anybody can vouch for, and
  /// a person who reinstalls the app or picks up a second phone must not be asked
  /// to start the review half again.
  ///
  /// WRITE ONCE, like wentToShopAt above it and for a weaker reason: nothing
  /// hangs off this deadline, so a second write would cost nothing. It is still
  /// refused, because "when did they go" has one answer and the first one is it.
  ///
  /// NOT A CLAIM THAT A REVIEW EXISTS. Whether a review is publicly visible is
  /// settled from the shop's own page and from nowhere else. This says only that
  /// somebody left to write one.
  wentToReviewAt DateTime?

  /// THE KEY IN THE ADDRESS OF THE ORDER FAYR WATCHED BEING PLACED, or null.
  ///
  /// ── TWO IDENTIFIERS, NEVER CONFUSED ──────────────────────────────────────
  ///
  /// MEASURED ON THE OWNER'S OWN ZEPTO PURCHASE, 18 SEPTEMBER 2026. One second
  /// after he paid, the shop's page inside Fayr moved to
  /// /order/status/01a0b4d7-870c-7dca-b701-e038477c5106. The shop's ADDRESS
  /// carries that UUID; the shop's PAGE prints an order number, JKLIKGSNS48449.
  /// Two different strings for one order.
  ///
  /// `orderId` above is the order NUMBER, read off the page by the server, and
  /// the refund gate reads it to stop one purchase paying twice. THIS is the
  /// ADDRESS KEY, reported by the phone the moment the confirmation page
  /// appeared, so the phone can open THAT ONE page later — for the order read,
  /// the delivery read and the review read — instead of walking the list, which
  /// is what read six strangers that evening.
  ///
  /// WRITING ONE INTO THE OTHER'S COLUMN WOULD BREAK THE DUPLICATE-ORDER GATE:
  /// the gate compares (platform, orderId) across tasks, and a UUID here beside
  /// a page number there would let one purchase pay twice unseen. So each has
  /// its own column, and nothing that decides money reads this one.
  ///
  /// UNTRUSTED, AND WRITTEN ONCE. It arrives through the same device-evidence
  /// route as everything else the phone reports; it is a place to look and not
  /// a fact about money; and the first key a task hears is the key it keeps. See
  /// tasks/engine/watched-order.ts for the rules and the reasons.
  watchedOrderKey String?

  /// HOW MANY DAYS THE ORDER WINDOW WAS WIDENED BY, FOR TESTING, WHEN IT WAS.
  ///
  /// NULL ON EVERY REAL TASK, and null is what it stays unless two things are
  /// both true at once: PRACTICE_ORDER_WINDOW_DAYS is set to a positive number,
  /// AND the live database's own name ends in _dev or _test. See
  /// tasks/engine/practice-window.ts, and tasks/practice-window.service.ts for
  /// the guard that asks the database rather than the settings.
  ///
  /// ── WHY A NUMBER AND NOT A YES OR NO ──────────────────────────────────────
  ///
  /// Because "this match was widened" is not enough to judge it by. A window
  /// widened by one day and a window widened by three years are different
  /// claims about how much was let through, and a staff member looking at a
  /// held refund needs the second one to be obvious.
  ///
  /// ── AND IT IS WRITTEN AT THE MOMENT IT IS USED ────────────────────────────
  ///
  /// Not worked out again later from the setting. The setting can be changed or
  /// turned off between the match and somebody looking at it, and a mark that
  /// disappears when the setting does is not a mark. This is the record that it
  /// happened, so a widened match can never be mistaken for a real one.
  practiceWindowDays Int?

  /// WHEN THIS PERSON ACCEPTED THIS OFFER'S OWN TERMS, and what they accepted.
  ///
  /// NOT the same thing as users.termsAcceptedAt, which is consent to Fayr itself
  /// and is given once during first-run setup. This is the tick box on the product
  /// page, given per offer, and the names are kept apart deliberately: two records
  /// sharing one name is how two different consents get mistaken for each other.
  ///
  /// The claim carries the acceptance and is refused without it, so a task created
  /// after 1 September 2026 cannot exist without these being set. They are
  /// nullable only because rows created before that date have no answer.
  ///
  /// The TEXT is frozen here from the SERVER's own copy of the campaign, never
  /// from the client, and for the same reason `category` is frozen: a campaign may
  /// be edited while it is paused, and a record of "they agreed to whatever the
  /// terms say now" is not a record. Null text means the campaign carried no terms
  /// of its own and the app showed its own default set, which is not yet held
  /// server side — a known gap, written down rather than papered over.
  offerTermsAcceptedAt DateTime?
  offerTermsText       String?

  blocker       String? // why the task can't advance (BLOCKERS in taskflow)
  blockerReason String?

  closedAt    DateTime? // terminal bookkeeping (refunded / expired / cancelled)
  closeReason String?

  /// The canonical nested evidence (order/review/delivery/target) exactly as the
  /// pure functions produce it.
  evidence Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events            TaskEvent[]
  visibilityChecks  VisibilityCheck[]
  screenshotUploads ScreenshotUpload[]
  orderCandidates   OrderCandidate[]
  /// THE REVIEW THEY WROTE INSIDE FAYR, or none.
  ///
  /// Its own table rather than columns here, because it is new primary data —
  /// somebody's own words — and not a projection of `evidence` the way the
  /// promoted columns above it are. It is also read far less often than a task
  /// row is, and there is no reason for every feed query to carry a paragraph.
  review            TaskReview?

  @@index([userId, state])
  @@index([campaignId])
  @@index([state, windowEndsAt]) // scheduler: holds whose return window has ended
  @@index([state, claimExpiresAt]) // scheduler: claims that expired unpurchased
  @@index([state, shopHoldEndsAt]) // sweep: two hour holds that have run out
  @@index([platform, orderId])
  @@index([platform, itemId]) // refund gate: has this order already been paid out?
  @@map("tasks")
}

/// Append-only log of every transition applied to a task — the audit history AND
/// the idempotency guarantee. The unique (taskId, idempotencyKey) makes replays
/// of the same event fail at the DATABASE, not just an in-memory `applied` check
/// (nulls are distinct in Postgres, so keyless events are never deduped).
model TaskEvent {
  id     String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  type           String // event type (EVIDENCE, START_HOLD, RELEASE_REFUND, ...)
  fromState      TaskState
  toState        TaskState
  reason         String?
  idempotencyKey String? // the event `key`; unique per task when present
  payload        Json? // the event data, for audit/replay
  createdAt      DateTime  @default(now())

  @@unique([taskId, idempotencyKey])
  @@index([taskId, createdAt])
  @@map("task_events")
}

/// Append-only audit trail of the HOLDING clawback re-checks (loophole 3, built
/// in 1.6). Each row records whether the review was still publicly visible at
/// `checkedAt`. A review that vanished mid-hold must be provable after the fact —
/// never a boolean that silently flipped.
/// WHERE AN ORDER WE ARE ASKING ABOUT CAME FROM.
///
/// order-list  the phone looked at the shop's own list of recent orders
/// screenshot  a picture the person uploaded, read by machine
/// hand-typed  the person typed it in themselves
///
/// hand-typed is kept apart on purpose: a staff member has to be able to see at a
/// glance which orders were never read by a machine at all.
enum OrderCandidateSource {
  ORDER_LIST
  SCREENSHOT
  HAND_TYPED
}

/// ONE ORDER WE ASKED SOMEBODY ABOUT, AND WHAT FAYR MADE OF IT.
///
/// THE PHONE LOOKS, THE SERVER JUDGES AND REMEMBERS. The phone can only look at
/// the shop's own list of orders, because the sign in lives on the device. What it
/// sends is the TEXT of each order it found. Every field below is read from that
/// text HERE, by backend/src/ocr/order-text.ts, and `matches` is decided HERE, by
/// matchOrderToCampaign. The phone is never asked whether something matched and
/// its opinion is not accepted if offered.
///
/// `reason` always names what happened — matched, product_name_not_found,
/// price_differs, no_products_read, no_campaign_product, no_expected_price. It is
/// never simply "no match", because that tells the next person reading this row
/// nothing at all.
model OrderCandidate {
  id     String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// 0 is the newest order on the shop's own list, so the order the shop showed
  /// first is the order shown first here.
  position Int

  source OrderCandidateSource @default(ORDER_LIST)

  orderNumber        String?
  orderDate          DateTime?
  /// THE DAY IT ARRIVED, which is not the day it was placed.
  ///
  /// Both are printed on an order's own page and both are kept. Reading one as
  /// the other would make an order look as though it was placed after it turned
  /// up. NULL when the page did not say, and null also when it said it without a
  /// year — "Delivered 5 June" is not a date, and filling the year in from today
  /// would be an invention. Additive and nullable: no existing row is rewritten.
  ///
  /// AND IT HOLDS AN INSTANT WHEN THE PAGE STATED ONE — Phase 8B-c, 20 September
  /// 2026. The name now says less than the column carries, and it is NOT renamed:
  /// a rename is a migration on a table whose rows somebody's refund has already
  /// been computed from, bought for a better word. A quick commerce page prints
  /// "Order Arrived at / 25 Aug 2026, 9:02 PM", and the minute is the difference
  /// between a three hour hold that runs from the delivery and one that runs from
  /// half past five in the evening whatever the page said. A page that prints
  /// only a day still stores that day at noon universal, exactly as before.
  /// See order-candidates.ts, theDeliveryInstant, which is the one rule that
  /// decides which of the two is written here.
  deliveryDate       DateTime?
  /// THE DAY THE SHOP'S OWN RETURN WINDOW CLOSES, as its last instant.
  ///
  /// Measured in words on the owner's own Amazon order page, 15 September 2026:
  /// "Return window closed on 19 June 2026". WITH a year, unlike the delivery
  /// line above it — and this one is never inferred, because refusing it costs
  /// nothing while the policy table still computes a window. The END of the day
  /// and not its middle: a window that closed on the 19th closed at the end of
  /// the 19th. Additive and nullable: no existing row is rewritten.
  returnWindowEndsAt DateTime?
  /// WHETHER IT WAS SENT BACK, as the page said it. TRI-STATE and no default:
  /// true is a completed return, false is a page that discusses returns and
  /// states none, null is a page that said nothing about one. "We did not look"
  /// and "we looked and it was not" are different facts wherever a refund is
  /// decided — the same reason tasks.returned is tri-state.
  returned           Boolean?
  /// What was charged for the whole order. Integer paise, never a float.
  totalPaise         BigInt?
  /// WHAT THE PRODUCTS ALONE CAME TO, as the page's own bill block states it.
  ///
  /// A total on its own cannot tell a delivery charge from a coupon: the owner's
  /// Zepto order #LRGSKOMA18669 (15 September 2026) states Item Total ₹74 and
  /// Total Bill ₹104, and the ₹30 between them is a delivery fee that is not
  /// refunded. Without this column that ₹30 is invisible and unexplainable.
  /// Additive and nullable: no existing row is rewritten, and null means the page
  /// stated no such line.
  itemTotalPaise     BigInt?
  /// DELIVERY, HANDLING AND SHIPPING, ADDED UP, as the page printed them.
  ///
  /// ZERO IS A REAL ANSWER and the commonest one — every fee on every fixture on
  /// disk was waived, printed as a struck figure with the word FREE under it.
  /// NULL is the different statement that the page named no charge at all. Only
  /// the labels in FEE_LABELS (ocr/order-text.ts) are counted, every one of them
  /// read off a page somebody really bought something on.
  feesPaise          BigInt?
  /// A DISCOUNT TAKEN OFF THE WHOLE BILL rather than off one product, positive.
  ///
  /// Measured once, on Amazon: "Promotion Applied: -₹80.00". No quick-commerce
  /// page has ever printed one — Zepto discounts each product on its own line
  /// instead, and that struck price is kept inside `items`. Null for none.
  billDiscountPaise  BigInt?
  /// Every product read off it: [{ name, pricePaise }]. pricePaise is a STRING of
  /// paise, because JSON has no place for a whole number this size.
  items              Json
  /// How many shipments the order was split into. One order can hold several.
  shipments          Int       @default(0)

  /// THE SERVER'S OWN ANSWER, never the phone's.
  matches Boolean
  reason  String

  /// Which one the person said was theirs, and when. Null until they answer.
  chosenAt DateTime?

  createdAt DateTime @default(now())

  @@unique([taskId, position])
  @@index([taskId, matches])
  @@map("order_candidates")
}

model VisibilityCheck {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  published Boolean
  checkedAt DateTime @default(now())
  source    String? // how visibility was determined (e.g. review permalink fetch)

  @@index([taskId, checkedAt])
  @@map("visibility_checks")
}

/// A ledger account. One USER account per user holds their refundable balance;
/// the system HOUSE (funding) and PAYOUT (withdrawal clearing) accounts are
/// singletons. Balance is SUM(amountPaise) over the account's entries — never a
/// stored mutable number. Append-only: an account gains entries, never edits.
model WalletAccount {
  id     String            @id @default(uuid()) @db.Uuid
  kind   WalletAccountKind
  userId String?           @db.Uuid
  user   User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  entries WalletEntry[]

  /// One account per (user, kind). The migration upgrades this to NULLS NOT
  /// DISTINCT so the system accounts (userId = null) are also enforced as
  /// singletons at the database level, not just by convention.
  @@unique([userId, kind])
  @@map("wallet_accounts")
}

/// One economic event, grouping the balanced legs that sum to zero. The unique
/// idempotencyKey makes posting safe under retries — a refund can never
/// double-post. referenceType/referenceId link it to its cause (e.g. a task).
model LedgerTransaction {
  id             String     @id @default(uuid()) @db.Uuid
  kind           LedgerKind
  idempotencyKey String     @unique
  referenceType  String?
  referenceId    String?
  memo           String?
  createdAt      DateTime   @default(now())

  entries WalletEntry[]

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

/// An append-only ledger leg: a signed paise amount posted to one account within
/// one transaction. NEVER updated or deleted (note the absence of @updatedAt).
/// Positive credits the account, negative debits it; a transaction's legs always
/// sum to zero (debits == credits). Enforced by the 1.2 service + a DB guard.
model WalletEntry {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @db.Uuid
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId     String            @db.Uuid
  account       WalletAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amountPaise   BigInt
  createdAt     DateTime          @default(now())

  @@index([accountId])
  @@index([transactionId])
  @@map("wallet_entries")
}

/// Append-only ticket ledger. Tickets are COUNTS, not money, so they are kept
/// separate from the paise wallet. Balance is SUM(delta). `balanceAfter` is
/// captured under a row lock for audit; the optional unique idempotencyKey makes
/// each lifecycle posting safe under retries.
model TicketEntry {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta          Int // +15 grant, -5 claim, +5 expiry-return, +10 completion
  reason         TicketReason
  taskId         String?      @db.Uuid
  balanceAfter   Int // running balance captured at post time, for audit
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
  @@map("ticket_entries")
}

// ===========================================================================
// PHASE 3 — WITHDRAWAL / PAYOUT
// ===========================================================================

/// A user's cash-out destination (UPI or bank). Cross-user dedup and PAN
/// anchoring (fraud loophole 1) are enforced by the service, not raw uniqueness,
/// so the SAME user may re-add an instrument while a DIFFERENT user is refused.
/// Instrument fields are stored as-is for the dev build; at-rest encryption is a
/// later hardening step.
model PayoutMethod {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @db.Uuid
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   PayoutMethodType

  upiId       String? // set when type = UPI
  bankAccount String? // set when type = BANK
  ifsc        String? // set when type = BANK
  accountName String? // set when type = BANK

  status    PayoutMethodStatus @default(ACTIVE)
  createdAt DateTime           @default(now())

  withdrawals Withdrawal[]

  @@index([userId])
  @@index([upiId])
  @@index([bankAccount, ifsc])
  @@map("payout_methods")
}

/// A cash-out request. Money moves out of the user's wallet at REQUEST time
/// (reserveTxn: USER -> PAYOUT, kind WITHDRAWAL); a REJECTED/FAILED request posts
/// a reversalTxn (PAYOUT -> USER, kind ADJUSTMENT). PAID is the external
/// disbursement being confirmed (utr) — it moves no ledger money (the funds
/// already left the user) and grants the +10 completion tickets.
model Withdrawal {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutMethodId String           @db.Uuid
  payoutMethod   PayoutMethod     @relation(fields: [payoutMethodId], references: [id], onDelete: Restrict)
  amountPaise    BigInt
  status         WithdrawalStatus @default(REQUESTED)

  // Ledger links (the balanced transactions this withdrawal produced).
  reserveTxnId  String? @db.Uuid
  reversalTxnId String? @db.Uuid

  utr           String? // external disbursement reference, recorded on PAID
  failureReason String? // why a REJECTED/FAILED withdrawal was refused

  // The staff member who decided it. A bare uuid (no FK), like AdminAuditLog's
  // target — the record must outlive any staff-account change.
  decidedByStaffId String?   @db.Uuid
  requestedAt      DateTime  @default(now())
  decidedAt        DateTime?
  updatedAt        DateTime  @updatedAt

  @@index([userId, requestedAt])
  @@index([status])
  @@map("withdrawals")
}

// ===========================================================================
// PHASE 2 — STAFF / ADMIN
// ===========================================================================
//
// A staff identity system WALLED OFF from the user app. Staff authenticate with
// email + password (argon2-hashed) and carry tokens signed with a SEPARATE
// secret (STAFF_JWT_SECRET), so a user access token can never be verified as a
// staff token and vice-versa — the isolation is cryptographic, not a role flag
// on the shared user token. RBAC (StaffRole) gates what each staff member can do.

enum StaffRole {
  SUPPORT // read user views, answer support questions
  FINANCE // view/approve/reject/pay withdrawals (+ read-only user view)
  OPERATIONS // create/edit/publish/pause campaigns
  ADMIN // everything above, plus the audit log + staff management
}

enum StaffStatus {
  ACTIVE
  DISABLED // login refused; kept (never deleted) so the audit trail stays intact
}

/// A back-office staff account. Distinct from User in every way: email+password
/// (not mobile-OTP), its own JWT trust domain, and a role. The password is stored
/// ONLY as an argon2 hash — a DB leak must never reveal a usable credential.
model StaffUser {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique // stored normalized (trimmed + lowercased)
  passwordHash String // argon2 hash — never the password itself
  name         String
  role         StaffRole   @default(SUPPORT)
  status       StaffStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  auditLogs      AdminAuditLog[]
  supportReplies SupportReply[]
  chatsTaken     Chat[]
  chatMessages   ChatMessage[]

  @@map("staff_users")
}

/// Append-only audit trail of staff actions — who did what, and (when relevant)
/// which Fayr user it concerned. This data is financial + PII, so access and
/// mutations are recorded here. `targetUserId` is a bare uuid, NOT a foreign key:
/// the audit trail must outlive user deletion, never cascade or null with it.
model AdminAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @db.Uuid
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  action       String // e.g. STAFF_LOGIN, USER_VIEW, QUESTION_REPLY
  targetUserId String?  @db.Uuid // the Fayr user this action concerned, if any
  metadata     Json? // action-specific context (never secrets)
  createdAt    DateTime @default(now())

  @@index([staffUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_audit_log")
}

/// A support question a user raises from the app, and the thread of replies on
/// it. Users submit and can follow up; staff answer from the back office. Status
/// tracks who's waiting: OPEN needs staff, ANSWERED is with the user, CLOSED is
/// resolved. A user follow-up re-OPENs; a staff reply ANSWERs.
model SupportQuestion {
  id      String         @id @default(uuid()) @db.Uuid
  userId  String         @db.Uuid
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject String
  body    String
  status  QuestionStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies SupportReply[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("support_questions")
}

enum QuestionStatus {
  OPEN // awaiting a staff answer
  ANSWERED // staff replied; with the user
  CLOSED // resolved
}

/// One message in a question's thread. Authorship is inferred from staffUserId:
/// null = the question's own user replied; set = a staff member replied. (No FK
/// to the user side — that's always the question's owner.)
model SupportReply {
  id         String          @id @default(uuid()) @db.Uuid
  questionId String          @db.Uuid
  question   SupportQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  body       String

  staffUserId String?    @db.Uuid
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([questionId, createdAt])
  @@map("support_replies")
}

// ===========================================================================
// PHASE 5 — SCREENSHOT OCR VERIFICATION (tier-3, supporting only)
// ===========================================================================
//
// A user may upload a screenshot as proof (purchase / delivery / review). Claude
// vision EXTRACTS the key fields, which are MATCHED against the campaign/task,
// producing a pending case a staff member must APPROVE before any evidence is
// accepted (see CLAUDE.md — OCR never auto-approves, never sole evidence). The
// image is PRIVATE PII: stored via StorageService.savePrivate (outside the public
// /uploads mount) and streamed back only through an RBAC-checked endpoint.

enum ScreenshotKind {
  PURCHASE // order-confirmation / order-details screenshot
  DELIVERY // "Delivered" status screenshot
  REVIEW // the live review on the product page
}

/// A user-uploaded screenshot. The bytes live in private storage (storageKey);
/// this row holds the metadata + the sha256 (dedup / forgery forensics — the same
/// image reused across users/tasks is a fraud signal, and the hash outlives the
/// image once retention purges it, setting deletedAt).
model ScreenshotUpload {
  id     String @id @default(uuid()) @db.Uuid
  taskId String @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind       ScreenshotKind
  storageKey String // opaque key into StorageService's PRIVATE space — never a URL
  mimetype   String
  sizeBytes  Int
  sha256     String // hex digest of the bytes

  uploadedAt DateTime  @default(now())
  deletedAt  DateTime? // set when the image is purged after retention; row/hash kept

  submission EvidenceSubmission?

  @@index([sha256]) // dedup: has this exact image been seen before?
  @@index([taskId])
  @@index([userId])
  @@map("screenshot_uploads")
}

enum EvidenceSubmissionStatus {
  UPLOADED // stored; extraction not yet run
  EXTRACTING // vision call in flight
  EXTRACTED // extracted + matched; awaiting staff review
  FAILED // extraction failed; staff can still eyeball the raw screenshot
  APPROVED // staff accepted → evidence funnelled into the task pipeline (source 'ocr')
  REJECTED // staff rejected
  NEEDS_MORE // staff asked the user for another screenshot
}

enum EvidenceVerdict {
  MATCH // all key fields matched the campaign/task
  PARTIAL // some matched, some didn't
  MISMATCH // key fields disagree
  UNKNOWN // couldn't tell (extraction failed / illegible)
}

/// The OCR "case" for one screenshot: the vision extraction, the match against the
/// campaign/task, and the staff decision. 1:1 with a ScreenshotUpload. Extraction
/// and match are JSON (the shape evolves); verdict + confidence are promoted for
/// sorting the review queue. The reviewing staff id is a bare uuid (like
/// Withdrawal.decidedByStaffId) so the record outlives any staff-account change.
model EvidenceSubmission {
  id                 String           @id @default(uuid()) @db.Uuid
  screenshotUploadId String           @unique @db.Uuid
  screenshot         ScreenshotUpload @relation(fields: [screenshotUploadId], references: [id], onDelete: Cascade)

  status EvidenceSubmissionStatus @default(UPLOADED)

  // Extraction (from Claude vision).
  model        String? // the vision model that ran
  extraction   Json? // extracted fields (order#, product, amountPaise, orderDate, …)
  tokensIn     Int?
  tokensOut    Int?
  costMicroUsd Int? // extraction cost in micro-USD, for the daily spend cap + reporting
  error        String? // extraction failure reason, if any

  // Match against the campaign/task expectations.
  match      Json? // per-field { expected, extracted, matched, note }
  verdict    EvidenceVerdict?
  confidence Int? // 0–100 (model confidence blended with match strength)

  // Staff decision (the mandatory human gate).
  reviewedByStaffId String?   @db.Uuid
  reviewReason      String?
  reviewedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt]) // the review queue
  @@map("evidence_submissions")
}

/// One run of the daily check over every live offer.
///
/// The findings themselves are a JSON snapshot rather than rows of their own, and
/// that is deliberate: a finding is only ever read as part of the run that
/// produced it, nothing joins to one, and the live report is recomputed on every
/// view anyway. What this table is for is the two things a live query cannot
/// answer — did the check actually run last night, and what is new since it did.
model CampaignCheckRun {
  id        String   @id @default(uuid()) @db.Uuid
  ranAt     DateTime @default(now())
  /// SCHEDULED (the nightly job) or MANUAL (someone pressed the button).
  trigger   String
  /// How many live offers were looked at.
  checked   Int
  blocking  Int
  attention Int
  unchecked Int
  /// [{ campaignId, title, code, severity }] — a snapshot, never joined to.
  findings  Json

  @@index([ranAt])
  @@map("campaign_check_runs")
}

// ===========================================================================
// PHASE 6 — THE ANSWER BOOK, AND THE RECORD OF EVERY REAL QUESTION
// ===========================================================================
//
// Three tables, and the split between them is the whole design:
//
//   answer_entries       one answer, in one language. The thing a person reads.
//   answer_phrases       the many ways somebody might ask for that answer.
//   assistant_questions  what a real person actually typed, and what we said back.
//
// Questions are kept apart from answers because a hundred differently-worded
// questions ("kab aayega", "refund not received", "मेरा पैसा कब आएगा") deserve ONE
// good answer, and fixing that answer must fix all hundred at once. If the text a
// user reads lived on the question, correcting it would mean correcting a hundred
// rows and hoping none was missed.
//
// SEARCHING AT SCALE. There will be a handful of answers this week and thousands
// in a year, and the matching may never read them all to find one. The migration
// that creates these tables also creates two kinds of index that make that
// possible without new infrastructure:
//
//   - a full-text index (GIN over to_tsvector) for matching by word, and
//   - a trigram index (GIN over pg_trgm) for matching despite a typo.
//
// Both live in Postgres, which is already here. The alternative — embeddings in a
// vector database — needs a paid model call on every question and a second service
// to run, and can be added later behind the same method without moving this data.

/// Is this answer live? RETIRED rather than deleted, because a question asked last
/// month recorded which answer it was shown, and that has to stay readable.
enum AnswerStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// Where an answer came from. Kept because "a person wrote this", "the assistant
/// drafted this" and "this shipped with the app" are read very differently when an
/// answer turns out to be wrong.
enum AnswerOrigin {
  SEED /// shipped with the app as fixed content
  ASSISTANT /// drafted by the assistant; a person must approve it before anyone sees it
  STAFF /// written or corrected by a person
}

/// One answer, in one language.
///
/// `key` is the identity of the ANSWER; `language` is which wording of it. The
/// same key carries every language, so a new language is new ROWS — never a
/// migration, and never a change to the code that reads them.
model AnswerEntry {
  id       String @id @default(uuid()) @db.Uuid
  key      String
  /// Short tag: en, hi, hi-en. A String and not an enum on purpose — see above.
  language String
  /// What this answer is called in a list. Plain words.
  title    String
  /// The answer itself, exactly as a user will read it. Plain words, no jargon —
  /// a rule the engine enforces in code before anything is ever returned.
  body     String
  /// Which part of the app this is about: refund, review, order, tickets, account.
  topic    String

  status AnswerStatus @default(DRAFT)
  origin AnswerOrigin @default(SEED)

  /// Bumped every time the words change, so a question can say which wording it
  /// showed even after a person has improved it.
  revision Int @default(1)

  /// Who last wrote it, when a person did. Bare uuid, not a foreign key: this
  /// record must outlive a staff account being removed.
  updatedByStaffId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phrases   AnswerPhrase[]
  questions AssistantQuestion[]

  @@unique([key, language])
  @@index([status, language])
  @@index([topic])
  @@map("answer_entries")
}

/// One way a real person might ask for one answer. This is the table the matching
/// actually searches, which is why it is separate: an answer with forty known
/// wordings is forty rows here and still one answer to correct.
model AnswerPhrase {
  id            String      @id @default(uuid()) @db.Uuid
  answerEntryId String      @db.Uuid
  answer        AnswerEntry @relation(fields: [answerEntryId], references: [id], onDelete: Cascade)

  text     String
  language String

  createdAt DateTime @default(now())

  @@index([answerEntryId])
  @@index([language])
  /// The near-miss index, declared here as well as in the migration that creates
  /// it. Without this line Prisma does not know it exists and the next
  /// `migrate dev` silently drops it — which would not fail a single test, and
  /// would quietly turn every typo search into a full read of the table.
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin, map: "answer_phrases_near_misses_idx")
  @@map("answer_phrases")
}

/// Where the reply a user saw came from.
enum AssistantAnswerOrigin {
  ANSWER_BOOK /// matched a stored answer
  MODEL /// written by a language model (not switched on yet)
  STAFF /// a person answered it
  NONE /// nothing matched, and we said so rather than inventing one
}

/// Who is waiting.
enum AssistantQuestionStatus {
  ANSWERED /// a reply was given; nobody is blocked
  UNRESOLVED /// nothing matched, or the person said the reply did not help
  RESOLVED /// closed, either by the person saying it helped or by staff
}

/// Every question a real person asked the assistant, and what happened next.
///
/// This is the record the whole thing learns from, so it keeps the EVIDENCE and
/// not a tidied version of it: the raw text is stored exactly as typed, and the
/// reply is snapshotted as shown rather than looked up later through a link that
/// may since have been edited.
model AssistantQuestion {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// EXACTLY what was typed. Never trimmed, corrected, or normalized: tomorrow's
  /// answer gets written from these words, and a cleaned-up copy would hide the
  /// spelling and the phrasing that are the most useful part.
  rawText String

  /// What language it LOOKS like, and how sure that guess was (0 to 100). Stored
  /// as a guess, because that is what it is.
  detectedLanguage   String
  languageConfidence Int

  askedAt DateTime @default(now())

  /// Which stored answer was used, if one was.
  answerEntryId  String?               @db.Uuid
  answerEntry    AnswerEntry?          @relation(fields: [answerEntryId], references: [id], onDelete: SetNull)
  /// The reply AS SHOWN to this person. Snapshotted: the entry above may be
  /// corrected next week, and "what did this person actually read" has to stay
  /// answerable after it is.
  answerText     String?
  answerOrigin   AssistantAnswerOrigin @default(NONE)
  /// How well it matched, 0 to 100. Null when nothing was returned.
  matchScore     Int?
  /// Which wording of the answer was shown, in case it has since changed.
  answerRevision Int?

  status AssistantQuestionStatus @default(UNRESOLVED)

  /// WHAT KIND OF QUESTION THIS WAS. Taken from the answer that served it, or set
  /// by the member of staff who answered it by hand. Null means nobody has said,
  /// which is itself the useful fact: an unsorted pile of questions nobody could
  /// answer is exactly what the answer book needs to be told about.
  topic String?

  /// Did it help? Null until asked, and null forever if they never say.
  helpful   Boolean?
  helpfulAt DateTime?

  /// When it stopped being anyone's problem. How long it took is this minus
  /// askedAt — computed on read, never stored twice.
  resolvedAt        DateTime?
  resolvedByStaffId String?   @db.Uuid

  /// What this person was doing in the app when they asked — a SNAPSHOT taken at
  /// that moment, assembled from records the app already keeps. A snapshot and not
  /// a live lookup, because reading their tasks next week tells you what is true
  /// next week, not what was true when they wrote in. The same reasoning as the
  /// offer check's findings, one table up.
  journey Json?

  /// Which conversation it was asked in. Optional because every question written
  /// down before conversations existed has none, and because the record of what
  /// somebody asked must never depend on the conversation still being there.
  chatId String? @db.Uuid
  chat   Chat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  messages ChatMessage[]

  @@index([status, askedAt])
  @@index([userId, askedAt])
  @@index([answerEntryId])
  @@index([askedAt])
  @@index([chatId, askedAt])
  /// Reading the pile of questions nobody could answer, newest first. The one
  /// read the "what should we write next" screen does.
  @@index([answerOrigin, askedAt])
  @@map("assistant_questions")
}

/// One morning's look at every live offer's real shop page.
///
/// Separate from the nightly offer check, which only reads Fayr's OWN records.
/// This one is about whether a page opens the way a shopper would see it, so it
/// can only be done from a real phone with a real signed-in shop session — which
/// is why it is started by hand and why the run records who started it.
///
/// The findings are a JSON snapshot for the same reason the offer check's are:
/// nothing joins to one, and the only questions a live query cannot answer are
/// "did somebody do this today" and "what changed since".
model LivePageCheckRun {
  id    String   @id @default(uuid()) @db.Uuid
  ranAt DateTime @default(now())

  /// Which staff member ran it. A bare uuid, not a foreign key: the record must
  /// outlive a staff account being removed.
  startedByStaffId String @db.Uuid

  /// How many live offers were looked at.
  checked      Int
  /// One count per state, so a screen never has to add up a JSON blob.
  opened       Int
  expired      Int
  soldOut      Int
  unavailable  Int
  couldNotOpen Int
  noLink       Int

  /// [{ campaignId, title, platform, state, httpStatus, evidence }] — a snapshot.
  findings Json

  @@index([ranAt])
  @@map("live_page_check_runs")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHATS
//
// A question and its reply were never a conversation. Somebody asks, the
// assistant answers or admits it cannot, and then there was nowhere for anyone
// to say anything else — no way for a person from Fayr to reply, and no way for
// the shopper to say "no, that is not what I meant".
//
// So the conversation is its own record, with the messages under it, and the
// question rows keep being the thing the answer book learns from. Both, not one
// instead of the other: a question is evidence, a chat is a conversation, and
// they answer different questions later.
// ─────────────────────────────────────────────────────────────────────────────

/// Who has a conversation right now.
enum ChatState {
  ASSISTANT /// the assistant is handling it and nobody needs to look
  WAITING_FOR_PERSON /// handed over; in the queue; nobody has taken it yet
  TAKEN /// a named member of staff has it and is the only one who may reply
  CLOSED /// finished
}

/// Who wrote one message.
enum ChatMessageAuthor {
  PERSON /// the shopper
  ASSISTANT /// the answer book
  AGENT /// a member of Fayr staff, by hand
  SYSTEM /// Fayr itself, saying something about the conversation
}

/// One conversation between one shopper and Fayr.
model Chat {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  state ChatState @default(ASSISTANT)

  /// Who has it, when someone does. A bare name is not enough: the rule is that
  /// only this person or an administrator may reply, and a name is not something
  /// you can check a rule against.
  takenByStaffId String?    @db.Uuid
  takenBy        StaffUser? @relation(fields: [takenByStaffId], references: [id], onDelete: SetNull)
  takenAt        DateTime?

  /// When it went into the queue, so how long people wait can be measured.
  handedOverAt DateTime?

  /// Which language this conversation is being held in, once the person has
  /// chosen one. Null means nobody has chosen, and the assistant answers in
  /// English — a decision, not a fallback: an answer in a language somebody did
  /// not ask for reads as a machine guessing at them.
  chosenLanguage String?

  /// When the offer to switch language was made. Made ONCE. Asking twice is how a
  /// helpful question turns into nagging.
  languageOfferedAt DateTime?

  /// When the "this is taking longer than usual" note was sent. Sent ONCE, for
  /// the same reason: a queue that keeps apologising is worse than a quiet one.
  waitingNoteSentAt DateTime?

  closedAt DateTime?

  startedAt     DateTime @default(now())
  /// Moved on every message, so the queue can be ordered by who has waited
  /// longest without counting rows.
  lastMessageAt DateTime @default(now())

  messages  ChatMessage[]
  questions AssistantQuestion[]

  /// The queue, oldest first. The one read the staff screen does constantly.
  @@index([state, handedOverAt])
  @@index([userId, lastMessageAt])
  @@index([takenByStaffId, lastMessageAt])
  @@map("chats")
}

/// One message in one conversation, in either direction.
model ChatMessage {
  id     String @id @default(uuid()) @db.Uuid
  chatId String @db.Uuid
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  author ChatMessageAuthor

  /// Set only when a member of staff wrote it. Kept even after they leave, so a
  /// conversation can still be read back with the right name against the words.
  staffUserId String?    @db.Uuid
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  body     String
  language String

  /// The question record this message belongs to, when there is one. A shopper's
  /// message creates a question; the reply to it points at the same one. That
  /// link is what lets the answer book learn from what people actually replied.
  assistantQuestionId String?            @db.Uuid
  assistantQuestion   AssistantQuestion? @relation(fields: [assistantQuestionId], references: [id], onDelete: SetNull)

  sentAt DateTime @default(now())

  /// Reading one conversation in order, which is every read this table gets.
  @@index([chatId, sentAt])
  @@index([assistantQuestionId])
  @@map("chat_messages")
}

// ===========================================================================
// GROWTH — PRODUCT MEASUREMENT
// ===========================================================================

/// What kind of thing happened. A String would have been less typing and the
/// wrong choice: the whole point of this table is that a funnel step means the
/// same thing in every query, and a typo in a string is a step that silently
/// vanishes from a count.
///
/// Adding a step is adding a value here. Removing one is not allowed: a retired
/// step still has to be countable in last quarter's numbers.
enum UserEventType {
  APP_OPENED /// the app was brought to the foreground
  ONBOARDING_DONE /// finished the onboarding carousel
  PHONE_ENTRY_SEEN /// reached the screen that asks for a number
  OTP_REQUESTED /// asked us to send a code
  OTP_VERIFIED /// entered a correct code
  ACCOUNT_CREATED /// that verification created a new account
  SETUP_STEP_DONE /// finished one step of the three-step setup
  SETUP_DONE /// finished setup altogether
  FEED_OPENED /// looked at the campaign list
  FIRST_CLAIM /// claimed a campaign for the very first time
  LOGGED_OUT /// signed out on purpose
  SESSION_RENEWED /// the app renewed a session without asking anybody
  SCREEN_VIEWED /// a screen in the app was drawn; the name is in the payload
}

/// One thing a person did, once, with a time on it.
///
/// APPEND-ONLY BY CONSTRUCTION, not by trigger. There is no @updatedAt and the
/// service only ever inserts. It is deliberately NOT guarded the way the money
/// ledgers are: those triggers exist because an edited ledger row is a lie about
/// money, and the cost of the guard (every reset script has to know about it) is
/// worth paying. This table is measurement. A wrong row here is a wrong chart,
/// and the demo reset has enough to remember already.
///
/// WHY userId IS NULLABLE. Half the funnel happens before anybody has an account
/// — opening the app, reading onboarding, reaching the phone screen. Those rows
/// carry an anonymousId instead, minted by the app on first run, and the row that
/// records a verified code carries both, which is the join that turns a stranger
/// into a person after the fact.
///
/// NO MOBILE NUMBER, EVER. A number is personal data and this table is read by
/// dashboards. The link from a pre-account event to a person is anonymousId, and
/// nothing else.
model UserEvent {
  id String @id @default(uuid()) @db.Uuid

  type UserEventType

  /// Set once there is an account. Null for everything before that.
  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The app's own first-run identifier. Survives sign-out, dies with the
  /// install — which is exactly the thing an install-to-signup funnel counts.
  anonymousId String?

  /// Anything the step needs to be countable: which setup step, which platform
  /// the feed was filtered to. Never anything that identifies a person.
  payload Json?

  at DateTime @default(now())

  /// Counting one step over a period, which is every read this table gets.
  @@index([type, at])
  @@index([userId, at])
  @@index([anonymousId, at])
  @@map("user_events")
}

/// THE REVIEW A PERSON WROTE INSIDE FAYR, AND THE SCORE THE SERVER GAVE IT.
///
/// ── WHY FAYR KEEPS THE WORDS AT ALL ─────────────────────────────────────────
///
/// Zepto, Blinkit and Swiggy Instamart have no review form. All they take is a
/// private star rating on the order, which nobody but the buyer can see. So for
/// those shops the written review is written in Fayr and STAYS in Fayr — the
/// shop gets the stars, and the descriptive feedback is the thing a brand is
/// actually paying for.
///
/// ── AND IT MOVES NO MONEY ───────────────────────────────────────────────────
///
/// Writing one releases no refund, advances no task state and touches no wallet.
/// That comes later and from somewhere else entirely: the shop's own page still
/// saying the rating is there after the return window. Nothing reads this table
/// to decide anything about a payout.
model TaskReview {
  id     String @id @default(uuid()) @db.Uuid
  taskId String @unique @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// EXACTLY WHAT THEY TYPED. Never trimmed, normalised, corrected or reflowed,
  /// on the way in or the way out. The whole company rests on these being real
  /// opinions in real people's own words, and a system that tidies them is a
  /// system that has started writing them.
  text String

  /// How DESCRIPTIVE it is, 0-100, and never how positive — see
  /// src/reviews/fayr-score.ts. Worked out by the SERVER from the text above,
  /// because a number the server cannot vouch for is not worth storing. The app
  /// scores as somebody types, for the person to see, and never sends it.
  score Int
  /// The same answer in a word: THIN, FAIR or STRONG. Stored beside the number
  /// because the band is what a person was actually shown, and a later change to
  /// where the band edges sit must not silently rewrite what somebody saw.
  band  String

  /// THE NUMBER OF STARS THEY GAVE THE PRODUCT AT THE SHOP, 1 to 5, or null.
  ///
  /// ── WHY FAYR KEEPS IT AT ALL ────────────────────────────────────────────
  ///
  /// The shop will never show us the review text back. On Zepto, Blinkit and
  /// Instamart all an order page ever says is that the product HAS been rated —
  /// never what the rating was. So this column is the only record anywhere of
  /// what they actually gave, and the owner asked for it to be kept.
  ///
  /// ── IT IS A RECORD AND NEVER A REASON TO PAY OR NOT PAY ─────────────────
  ///
  /// Nothing in the refund gate, the task engine, the wallet or the task service
  /// reads this. A one-star rating is paid exactly as a five-star one is, and a
  /// check walks the whole of backend/src to keep that true.
  ///
  /// NULLABLE ON PURPOSE. Somebody may write the review before deciding the
  /// number, and nothing in Fayr may ever force one out of them.
  stars Int?

  writtenAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_reviews")
}
