{
  "expo": {
    "name": "fayr",
    "slug": "fayr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.fayr"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.anonymous.fayr"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "./plugins/withFmtConsteval",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fayr needs your photo library so you can send a screenshot of your order or review as proof. Only the image you pick is uploaded."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
